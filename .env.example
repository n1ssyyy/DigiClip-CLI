# DigiClip CLI — copy to .env (or export) for local runs.
# Only clip *scoring* optionally calls OpenRouter; everything else is offline.

# Bring-your-own-key for LLM clip scoring. Unset -> offline heuristic scorer.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_S=300
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash

# Explicit ffmpeg override (default: provisioned bin/ -> resources/bin/<platform>/ -> PATH)
# DIGICLIP_FFMPEG=C:\ffmpeg\bin\ffmpeg.exe
